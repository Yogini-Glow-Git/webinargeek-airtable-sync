# Kopiere diese Datei zu ".env" und fuelle die Werte.

PORT=3000

# Airtable Personal Access Token, Scopes data.records:read + data.records:write
# auf Base appVOaD792Y5oQsu5 (Yogini Glow Dashboard).
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appVOaD792Y5oQsu5

# Secret, das beim Anlegen des Webhooks in WebinarGeek (Account > Integrations >
# Webhooks) im Feld "Secret" eingetragen wird. Ohne dieses Secret laeuft der Server,
# aber OHNE Signaturpruefung - siehe Warnung in server.js.
WEBINARGEEK_WEBHOOK_SECRET=

# Optional: Slack Incoming-Webhook-URL fuer Fehler-Alarme bei fehlgeschlagener
# Verarbeitung (sonst landen Fehler nur im Server-Log).
SLACK_WEBHOOK_URL=

# Optional: Komma-getrennte Liste der WebinarGeek-Event-Namen, die als
# "Neuanmeldung" behandelt werden. Default deckt gaengige Varianten ab; nach dem
# ersten echten Webhook-Test ggf. auf den tatsaechlichen Namen einschraenken.
# WG_REGISTRATION_EVENTS=webinar_subscribed

# Secret fuer den ZWEITEN Easy2-Webhook (parallel zum bestehenden, der auf
# easy2toolbox.de/Zapier zeigt - wird von diesem Secret NICHT beruehrt). Beim
# Anlegen per POST https://yogini-glow.easy2.de/api/site/webhooks mitgeben.
# Ohne dieses Secret laeuft der Server, aber OHNE Signaturpruefung fuer /webhooks/easy2.
EASY2_WEBHOOK_SECRET=

# WebinarGeek API-Token (Api-Token-Header), fuer die direkte Webinar-Anmeldung
# (Ersatz "Easy2 to Webinargeek Anmeldung"). Ohne dieses Token wird die
# Registrierung nur geloggt, nicht ausgefuehrt.
WEBINARGEEK_API_TOKEN=

# ---- Funnel-Registry (zwei parallele Webinare, siehe lib/webinarRegistration.js) ----
# Optional: Webinar-Id des Shift-Funnels (B2B, Landing Page shift.yogini-glow.de).
# Default 517362 = "Yoga Shift 2026 - Yoga Expertin fuer Frauengesundheit".
# WEBINARGEEK_MAIN_WEBINAR_ID=517362
#
# Optional: Webinar-Id des Yogini-Path-Funnels (B2C, Landing Page
# live-event.yogini-glow.de). Default 583070 = "The Yogini Path".
# WEBINARGEEK_PATH_WEBINAR_ID=583070
#
# Optional: Easy2-Tag-Prefixes je Funnel. Getrennte Prefixes halten die
# B2B-Nurture-/Call-Automationen von den B2C-Anmeldungen fern (sonst waeren beide
# in Easy2 nur am Termindatum unterscheidbar). Ergebnis-Tags z.B.
# "Web_27Sep26_angemeldet" (shift) bzw. "Path_11Okt26_angemeldet" (path).
# EASY2_TAG_PREFIX_SHIFT=Web
# EASY2_TAG_PREFIX_PATH=Path
#
# Optional: Cache-Dauer fuer GET /next-broadcast (Termin-Auskunft fuer die
# Landingpages) in Millisekunden. Default 600000 (10 Minuten). Kleiner machen
# heisst: ein neu angelegter Termin erscheint schneller auf den Seiten, kostet
# aber mehr WebinarGeek-API-Calls.
# NEXT_BROADCAST_TTL_MS=600000

# Optional: Komma-getrennte Easy2-Listen-Ids, die "hat sich fuers Webinar
# angemeldet" signalisieren (Default 238677122 = "8. Webinar Anmeldung").
# EASY2_WEBINAR_SIGNUP_LIST_ID=238677122

# Easy2 API-Key (derselbe wie in Feminine-Balance-Journal-2/website/.env.local),
# NUR fuer das Setzen des "Web_{Datum}_angemeldet"-Tags nach erfolgreicher
# Webinar-Registrierung (lib/webinarRegistration.js::tagEasy2ForBroadcast).
# Ohne diesen Key wird nur die Registrierung ausgefuehrt, der Tag NICHT gesetzt.
EASY2_API_KEY=

# Shared Secret fuer POST /register-lead (wird von den eigenen Landing Pages
# shift.yogini-glow.de UND live-event.yogini-glow.de per Header X-Internal-Secret
# mitgeschickt). Derselbe Wert muss dort jeweils als REGISTER_LEAD_SECRET gesetzt
# sein. Ohne dieses Secret nimmt der Endpoint Requests von JEDEM Absender an -
# live IMMER setzen.
REGISTER_LEAD_SECRET=

# Fuer scripts/sync-lp-traffic.js (taeglicher Top-of-Funnel-Sync shift.yogini-glow.de
# -> Airtable LP_Traffic_Daily). Muss mit STATS_SYNC_SECRET auf der Landing Page
# uebereinstimmen. LP_STATS_URL optional, Default https://shift.yogini-glow.de.
STATS_SYNC_SECRET=
LP_STATS_URL=
