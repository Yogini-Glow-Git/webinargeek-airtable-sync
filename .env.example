# Kopiere diese Datei zu ".env" und fuelle die Werte.

PORT=3000

# Airtable Personal Access Token, Scopes data.records:read + data.records:write
# auf Base appVOaD792Y5oQsu5 (Yogini Glow Dashboard).
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appVOaD792Y5oQsu5

# Secret, das beim Anlegen des Webhooks in WebinarGeek (Account > Integrations >
# Webhooks) im Feld "Secret" eingetragen wird. Ohne dieses Secret laeuft der Server,
# aber OHNE Signaturpruefung - siehe Warnung in server.js.
WEBINARGEEK_WEBHOOK_SECRET=

# Optional: Slack Incoming-Webhook-URL fuer Fehler-Alarme bei fehlgeschlagener
# Verarbeitung (sonst landen Fehler nur im Server-Log).
SLACK_WEBHOOK_URL=

# Optional: Komma-getrennte Liste der WebinarGeek-Event-Namen, die als
# "Neuanmeldung" behandelt werden. Default deckt gaengige Varianten ab; nach dem
# ersten echten Webhook-Test ggf. auf den tatsaechlichen Namen einschraenken.
# WG_REGISTRATION_EVENTS=webinar_subscribed

# Secret fuer den ZWEITEN Easy2-Webhook (parallel zum bestehenden, der auf
# easy2toolbox.de/Zapier zeigt - wird von diesem Secret NICHT beruehrt). Beim
# Anlegen per POST https://yogini-glow.easy2.de/api/site/webhooks mitgeben.
# Ohne dieses Secret laeuft der Server, aber OHNE Signaturpruefung fuer /webhooks/easy2.
EASY2_WEBHOOK_SECRET=
